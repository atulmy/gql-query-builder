{
  "name": "gql-query-builder",
  "version": "4.0.0",
  "description": "Simple GraphQL Query Builder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atulmy/gql-query-builder.git"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check-package": "publint && attw --pack .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepare": "husky"
  },
  "keywords": [
    "graphql",
    "query",
    "builder",
    "javascript",
    "typescript"
  ],
  "author": "Atul Yadav <atul.12788@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/atulmy/gql-query-builder/issues"
  },
  "homepage": "https://github.com/atulmy/gql-query-builder",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.3",
    "@changesets/cli": "^2.31.0",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "publint": "^0.3.21",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
